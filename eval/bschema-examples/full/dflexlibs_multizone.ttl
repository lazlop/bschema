        a ref:TimeseriesReference ;
        ref:hasTimeseriesId ("Occupancy[cor]" "Occupancy[eas]") ;
        ref:onTable ("scheduleData_dataset") ;
        ref:storedAt ("data.db")
    ] ,
    [
        ref:hasTimeseriesId ("Occupancy[cor]" "Occupancy[eas]")
    ] .
(ns1:chi_pump) a brick:Pump .
(ns1:chi_pump) brick:hasPoint (ns1:chi_reaPPumDis_y) .
(ns1:heat_pump) a brick:Pump .
(ns1:heat_pump) brick:feeds (ns1:hwd_pump) .
(ns1:heat_pump) brick:hasPoint (ns1:heaPum_reaPHeaPum_y) .
(ns1:hvac_reaAhu_V_flow_ret_y) a brick:Return_Air_Flow_Sensor .
(ns1:hvac_reaAhu_V_flow_ret_y) ref:hasExternalReference [
    ref:hasTimeseriesId ("hvac_reaAhu_V_flow_ret_y")
] .
(ns1:hvac_reaAhu_TRet_y) a brick:Return_Air_Temperature_Sensor .
(ns1:hvac_reaAhu_TRet_y) ref:hasExternalReference [
    ref:hasTimeseriesId ("hvac_reaAhu_TRet_y")
] .
(ns1:hvac_reaAhu_V_flow_sup_y) a brick:Supply_Air_Flow_Sensor .
(ns1:hvac_reaAhu_V_flow_sup_y) ref:hasExternalReference [
    ref:hasTimeseriesId ("hvac_reaAhu_V_flow_sup_y")
] .
(ns1:hvac_reaAhu_TSup_y) a brick:Supply_Air_Temperature_Sensor .
(ns1:hvac_reaAhu_TSup_y) ref:hasExternalReference [
    ref:hasTimeseriesId ("hvac_reaAhu_TSup_y")
] .
(ns1:hvac_oveAhu_TSupSet_u) a brick:Supply_Air_Temperature_Setpoint .
(ns1:hvac_oveAhu_TSupSet_u) ref:hasExternalReference [
    ref:hasTimeseriesId ("hvac_oveAhu_TSupSet_u")
] .
(ns1:hvac_fanSup) a brick:Supply_Fan .
(ns1:hvac_fanSup) brick:hasPoint
    (ns1:hvac_reaAhu_PFanSup_y) ,
    (ns1:hvac_reaAhu_dp_sup_y) .
(ns1:hvac_oveZonActCor_yReaHea_u ns1:hvac_oveZonActEas_yReaHea_u) a brick:Valve_Command .
(ns1:hvac_oveZonActCor_yReaHea_u ns1:hvac_oveZonActEas_yReaHea_u) ref:hasExternalReference [
    ref:hasTimeseriesId ("hvac_oveZonActCor_yReaHea_u" "hvac_oveZonActEas_yReaHea_u")
] .
(ns1:vav_cor ns1:vav_eas) a brick:Variable_Air_Volume_Box_With_Reheat .
(ns1:vav_cor ns1:vav_eas) brick:feeds (ns1:hvac_cor_zone ns1:hvac_eas_zone) .
(ns1:vav_cor ns1:vav_eas) brick:hasPoint
    (ns1:hvac_oveZonActCor_yReaHea_u ns1:hvac_oveZonActEas_yReaHea_u) ,
    (ns1:hvac_reaZonCor_TSup_y ns1:hvac_reaZonEas_TSup_y) ,
    (ns1:hvac_oveZonActCor_yDam_u ns1:hvac_oveZonActEas_yDam_u) .
(ns1:hvac_oveZonSupCor_TZonCooSet_u ns1:hvac_oveZonSupEas_TZonCooSet_u) a brick:Zone_Air_Cooling_Temperature_Setpoint .
(ns1:hvac_oveZonSupCor_TZonCooSet_u ns1:hvac_oveZonSupEas_TZonCooSet_u) ref:hasExternalReference

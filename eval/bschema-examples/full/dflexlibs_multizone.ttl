@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix ref: <https://brickschema.org/schema/Brick/ref#> .
@prefix ns1: <urn:bldg/> .

(ns1:hvac_ahu) a brick:AHU .
(ns1:hvac_ahu) brick:feeds (ns1:vav_cor ns1:vav_eas) .
(ns1:hvac_ahu) brick:hasPart
    (ns1:hvac_fanSup) ,
    (ns1:heating_coil) ,
    (ns1:cooling_coil) .
(ns1:hvac_ahu) brick:hasPoint
    (ns1:hvac_oveAhu_TSupSet_u) ,
    (ns1:hvac_reaAhu_TSup_y) ,
    (ns1:hvac_reaAhu_V_flow_sup_y) ,
    (ns1:hvac_reaAhu_TRet_y) ,
    (ns1:hvac_reaAhu_V_flow_ret_y) ,
    (ns1:hvac_reaAhu_TMix_y) .
(ns1:Building) a brick:Building .
(ns1:Building) brick:area [
    brick:value ("1662.66"^^xsd:float)
] .
(ns1:Building) brick:hasPart (ns1:hvac_cor_zone ns1:hvac_eas_zone) .
(ns1:hvac_reaZonCor_CO2Zon_y ns1:hvac_reaZonEas_CO2Zon_y) a brick:CO2_Sensor .
(ns1:hvac_reaZonCor_CO2Zon_y ns1:hvac_reaZonEas_CO2Zon_y) ref:hasExternalReference [
    ref:hasTimeseriesId ("hvac_reaZonCor_CO2Zon_y" "hvac_reaZonEas_CO2Zon_y")
] .
(ns1:chi_reaTRet_y) a brick:Chilled_Water_Return_Temperature_Sensor .
(ns1:chi_reaTRet_y) ref:hasExternalReference [
    ref:hasTimeseriesId ("chi_reaTRet_y")
] .
(ns1:chi_reaTSup_y) a brick:Chilled_Water_Supply_Temperature_Sensor .
(ns1:chi_reaTSup_y) ref:hasExternalReference [
    ref:hasTimeseriesId ("chi_reaTSup_y")
] .
(ns1:chiller) a brick:Chiller .
(ns1:chiller) brick:feeds (ns1:chi_pump) .
(ns1:chiller) brick:hasPoint
    (ns1:chi_reaPChi_y) ,
    (ns1:chi_reaTSup_y) ,
    (ns1:chi_reaTRet_y) .
(ns1:cooling_coil) a brick:Cooling_Coil .
(ns1:cooling_coil) brick:hasPoint (ns1:hvac_reaAhu_PPumCoo_y) .
(ns1:cooling_coil) brick:isFedBy (ns1:chiller) .
(ns1:hvac_oveZonActCor_yDam_u ns1:hvac_oveZonActEas_yDam_u) a brick:Damper_Position_Setpoint .
(ns1:hvac_oveZonActCor_yDam_u ns1:hvac_oveZonActEas_yDam_u) ref:hasExternalReference [
    ref:hasTimeseriesId ("hvac_oveZonActCor_yDam_u" "hvac_oveZonActEas_yDam_u")
] .
(ns1:hvac_reaZonCor_V_flow_y ns1:hvac_reaZonEas_V_flow_y) a brick:Discharge_Air_Flow_Sensor .
(ns1:hvac_reaZonCor_V_flow_y ns1:hvac_reaZonEas_V_flow_y) ref:hasExternalReference [
    ref:hasTimeseriesId ("hvac_reaZonCor_V_flow_y" "hvac_reaZonEas_V_flow_y")
] .
(ns1:hvac_reaAhu_dp_sup_y) a brick:Discharge_Air_Static_Pressure_Sensor .
(ns1:hvac_reaAhu_dp_sup_y) ref:hasExternalReference [
    ref:hasTimeseriesId ("hvac_reaAhu_dp_sup_y")
] .
(ns1:hvac_reaZonCor_TSup_y ns1:hvac_reaZonEas_TSup_y) a brick:Discharge_Air_Temperature_Sensor .
(ns1:hvac_reaZonCor_TSup_y ns1:hvac_reaZonEas_TSup_y) ref:hasExternalReference [
    ref:hasTimeseriesId ("hvac_reaZonCor_TSup_y" "hvac_reaZonEas_TSup_y")
] .
(ns1:chi_reaPChi_y) a brick:Electric_Power_Sensor .
(ns1:chi_reaPChi_y) ref:hasExternalReference
    [
        a ref:TimeseriesReference ;
        ref:hasTimeseriesId ("chi_reaPChi_y") ;
        ref:onTable ("baseline_dataset" "flexible_dataset") ;
        ref:storedAt ("data.db")
    ] ,
    [
        ref:hasTimeseriesId ("chi_reaPChi_y")
    ] .
(ns1:chi_reaPPumDis_y) a brick:Electric_Power_Sensor .
(ns1:chi_reaPPumDis_y) ref:hasExternalReference
    [
        a ref:TimeseriesReference ;
        ref:hasTimeseriesId ("chi_reaPPumDis_y") ;
        ref:onTable ("baseline_dataset" "flexible_dataset") ;
        ref:storedAt ("data.db")
    ] ,
    [
        ref:hasTimeseriesId ("chi_reaPPumDis_y")
    ] .

(ns1:hvac_reaAhu_TMix_y) a brick:Mixed_Air_Temperature_Sensor .
(ns1:hvac_reaAhu_TMix_y) ref:hasExternalReference [
    ref:hasTimeseriesId ("hvac_reaAhu_TMix_y")
] .
(ns1:occ_cor ns1:occ_eas) a brick:Occupancy_Sensor .
(ns1:occ_cor ns1:occ_eas) ref:hasExternalReference

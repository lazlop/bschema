            sh:object tag:Temperature ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Zone ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:Relationship brick:Temperature,
        brick:Zone_Air,
        tag:Air,
        tag:Point,
        tag:Setpoint,
        tag:Target,
        tag:Temperature,
        tag:Zone ;

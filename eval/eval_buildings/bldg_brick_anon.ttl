unit:N-PER-M a qudt:DerivedUnit,
        qudt:Unit ;
    rdfs:label "مقياس التبادل، الأس السالب للمتر"@ar,
        "newtonů na metr"@cs,
        "Newton je Meter"@de,
        "newton per metre"@en,
        "Newton per Meter"@en-us,
        "newton por metro"@es,
        "نیوتن بر متر"@fa,
        "newton par mètre"@fr,
        "प्रति मीटर न्यूटन"@hi,
        "newton al metro"@it,
        "ニュートン毎メートル"@ja,
        "newton per meter"@ms,

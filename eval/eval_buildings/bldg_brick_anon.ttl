    qudt:literal "°/m" ;
    qudt:symbol "°/m" ;
    qudt:ucumCode "deg.m-1"^^qudt:UCUMcs,
        "deg/m"^^qudt:UCUMcs ;
    qudt:uneceCommonCode "H27" ;
    dtype:literal "°/m" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> ;
    skos:notation "deg.m-1"^^qudt:UCUMcs,
        "deg/m"^^qudt:UCUMcs .


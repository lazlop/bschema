    dtype:literal "rad/min" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> ;
    skos:notation "rad.min-1"^^qudt:UCUMcs,
        "rad/min"^^qudt:UCUMcs .


            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Effective ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Heat ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Point ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Setpoint ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Supply ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Temperature ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:Relationship brick:Temperature,
        tag:Air,
        tag:Discharge,
        tag:Effective,
        tag:Heat,
        tag:Point,
        tag:Setpoint,
        tag:Supply,
        tag:Temperature ;
    brick:hasAssociatedTag tag:Air,
        tag:Discharge,
        tag:Effective,
        tag:Heat,
        tag:Point,
        tag:Setpoint,
        tag:Supply,
        tag:Temperature ;

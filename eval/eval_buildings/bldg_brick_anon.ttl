    brick:hasTag tag:Measurable .

brick:Gain_Parameter a owl:Class,
        sh:NodeShape ;
    rdfs:subClassOf brick:PID_Parameter ;
    sh:rule [ a sh:TripleRule ;
            sh:object tag:Gain ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:PID ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Parameter ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;

        [ a sh:TripleRule ;
            sh:object tag:Plenum ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:Relationship tag:Air,
        tag:Equipment,
        tag:Plenum ;
    brick:hasAssociatedTag tag:Air,
        tag:Equipment,
        tag:Plenum .

brick:Air_Temperature_Alarm a owl:Class,
        sh:NodeShape ;
    rdfs:subClassOf brick:Air_Alarm,

    qudt:isUnitOfSystem sou:IMPERIAL,
        sou:USCS ;
    qudt:literal "in/min" ;
    qudt:symbol "in/min" ;
    qudt:ucumCode "[in_i].min-1"^^qudt:UCUMcs,
        "[in_i]/min"^^qudt:UCUMcs ;
    qudt:uneceCommonCode "M63" ;
    dtype:literal "in/min" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> ;
    skos:notation "[in_i].min-1"^^qudt:UCUMcs,
        "[in_i]/min"^^qudt:UCUMcs .

unit:IN-PER-PSI a qudt:Unit ;
    rdfs:label "inch per psi" ;
    dcterms:description "unit inch according to the Anglo-American and the Imperial system of units divided by the composed unit for pressure (pound-force per square inch)" ;

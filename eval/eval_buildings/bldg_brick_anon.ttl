        [ a sh:TripleRule ;
            sh:object tag:Radiant ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:Relationship tag:Ceiling,
        tag:Equipment,
        tag:Panel,
        tag:RC,
        tag:Radiant ;
    brick:hasAssociatedTag tag:Ceiling,
        tag:Equipment,
        tag:Panel,
        tag:RC,
        tag:Radiant .


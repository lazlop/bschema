        qudt:Unit ;
    rdfs:label "Degree per Hour"@en ;
    dcterms:description "\"Degree per Hour\" is an Imperial unit for  'Angular Velocity' expressed as $deg/h$."^^qudt:LatexString ;
    qudt:applicableSystem sou:IMPERIAL ;

        [ a sh:PropertyShape ;
            sh:in ( unit:FT3 unit:AC-FT_US unit:GI_US unit:M3 unit:FemtoL unit:OZ_VOL_UK unit:TBSP unit:MicroL unit:QT_US unit:AC-FT unit:MilliL unit:MI_UK3 unit:Standard unit:STR unit:PINT_UK unit:TON_SHIPPING_US unit:RT unit:BBL_US unit:PlanckVolume unit:TON_SHIPPING_UK unit:FBM unit:HectoL unit:ANGSTROM3 unit:QT_UK unit:MI3 unit:DecaM3 unit:L unit:Kilo-FT3 unit:TON_Register unit:PicoL unit:DecaL unit:GI_UK unit:BBL unit:KiloL unit:GT unit:MicroM3 unit:DeciL unit:IN3 unit:PINT unit:PK_UK unit:YD3 unit:MilliM3 unit:NanoL unit:MegaL unit:BBL_UK_PET unit:TSP unit:DeciM3 unit:CentiM3 ) ;
            sh:maxCount 1 ;

        quantitykind:Velocity ;
    qudt:literal "nmi/min" ;
    qudt:symbol "nmi/min" ;
    qudt:ucumCode "[nmi_i].min-1"^^qudt:UCUMcs,
        "[nmi_i]/min"^^qudt:UCUMcs ;
    dtype:literal "nmi/min" ;

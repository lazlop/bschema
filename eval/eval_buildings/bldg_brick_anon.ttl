            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Temperature ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:Relationship brick:Temperature,
        tag:Heat,
        tag:Occupied,
        tag:Point,
        tag:Setpoint,
        tag:Temperature ;
    brick:hasAssociatedTag tag:Heat,
        tag:Occupied,
        tag:Point,
        tag:Setpoint,

    qudt:hasQuantityKind quantitykind:ForcePerArea,
        quantitykind:ModulusOfElasticity,
        quantitykind:ShearModulus,
        quantitykind:VaporPressure ;
    qudt:iec61360Code "0112/2///62720#UAA575" ;
    qudt:literal "kPa" ;

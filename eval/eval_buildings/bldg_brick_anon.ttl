            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Point ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Sensor ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:Relationship quantitykind:Dimensionless,
        tag:Motion,
        tag:Point,
        tag:Sensor ;
    brick:hasAssociatedTag tag:Motion,
        tag:Point,
        tag:Sensor ;

        [ a sh:TripleRule ;
            sh:object tag:Temperature ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:Relationship tag:Color,
        tag:Command,
        tag:Correlated,
        tag:Lighting,
        tag:Point,
        tag:Temperature ;
    brick:hasAssociatedTag tag:Color,
        tag:Command,
        tag:Correlated,
        tag:Lighting,
        tag:Point,
        tag:Temperature .


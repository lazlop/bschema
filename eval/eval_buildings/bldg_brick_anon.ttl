    qudt:literal "fm" ;
    qudt:omUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/fermi> ;
    qudt:symbol "fm" ;
    qudt:uneceCommonCode "A71" ;
    dtype:literal "fm" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> .


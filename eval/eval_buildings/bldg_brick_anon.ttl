            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Point ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:Relationship tag:Gain,
        tag:Integral,
        tag:PID,
        tag:Parameter,
        tag:Point ;
    brick:hasAssociatedTag tag:Gain,
        tag:Integral,
        tag:PID,
        tag:Parameter,
        tag:Point .


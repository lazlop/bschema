    qudt:hasDimensionVector qkdv:A0E0L0I0M0H0T-2D0 ;
    qudt:hasQuantityKind quantitykind:AngularAcceleration ;
    qudt:iec61360Code "0112/2///62720#UAA969",
        "0112/2///62720#UAD506" ;
    qudt:isUnitOfSystem sou:SI ;
    qudt:literal "rad/s²" ;
    qudt:symbol "rad/s²" ;
    qudt:ucumCode "rad.s-2"^^qudt:UCUMcs,

    qudt:symbol "GB" ;
    qudt:ucumCode "GBy"^^qudt:UCUMcs ;
    qudt:uneceCommonCode "E34" ;
    dtype:literal "GB" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> ;
    skos:altLabel "gbyte" ;
    skos:notation "GBy"^^qudt:UCUMcs .


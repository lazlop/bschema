    qudt:conversionMultiplier 1.0 ;
    qudt:conversionMultiplierSN 1e+00 ;
    qudt:hasDimensionVector qkdv:A0E0L-2I1M0H0T0D0 ;
    qudt:hasQuantityKind quantitykind:Luminance ;

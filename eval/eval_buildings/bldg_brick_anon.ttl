    qudt:derivedCoherentUnitOfSystem sou:SI ;
    qudt:derivedUnitOfSystem sou:SI ;
    qudt:expression "$N/C$"^^qudt:LatexString ;
    qudt:hasDimensionVector qkdv:A0E-1L1I0M1H0T-3D0 ;

brick:Fire_Sensor a owl:Class,
        sh:NodeShape ;
    qudt:hasQuantityKind quantitykind:Dimensionless ;
    rdfs:subClassOf brick:Sensor ;
    skos:definition "Measures the presence of fire"@en ;

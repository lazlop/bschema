            sh:datatype xsd:anyURI ;
            sh:description "URL link to an image that represents the person."^^xsd:string ;
            sh:name "image"^^xsd:string ;
            sh:path rec:image ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:path rec:familyName ] .


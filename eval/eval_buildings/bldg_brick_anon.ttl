qudt:Prefix a owl:Class ;
    rdfs:label "Prefix" ;
    rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom qudt:Prefix ;
            owl:onProperty qudt:exactMatch ],
        [ a owl:Restriction ;
            owl:allValuesFrom qudt:UCUMcs-term ;
            owl:onProperty qudt:ucumCode ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty qudt:prefixMultiplier ],
        [ a owl:Restriction ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty qudt:latexSymbol ],
        [ a owl:Restriction ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty qudt:symbol ],
        qudt:Concept,
        qudt:Verifiable .

brick:Air_Flow_Setpoint a owl:Class,
        sh:NodeShape ;
    qudt:hasQuantityKind quantitykind:VolumeFlowRate ;
    rdfs:subClassOf brick:Flow_Setpoint ;
    skos:definition "Sets air flow"@en ;
    sh:rule [ a sh:TripleRule ;
            sh:object tag:Air ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Flow ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Point ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Setpoint ;

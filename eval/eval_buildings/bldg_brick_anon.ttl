    qudt:literal "ZC" ;
    qudt:prefix prefix:Zetta ;
    qudt:symbol "ZC" ;
    qudt:ucumCode "ZC"^^qudt:UCUMcs ;
    dtype:literal "ZC" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> ;

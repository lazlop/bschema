brick:Smoke_Detection_Alarm a owl:Class,
        sh:NodeShape ;
    rdfs:subClassOf brick:Smoke_Alarm ;
    sh:rule [ a sh:TripleRule ;
            sh:object tag:Alarm ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Detection ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Point ;
            sh:predicate brick:hasTag ;

            sh:class rec:BooleanValueObservation ;
            sh:maxCount 1 ;
            sh:name "last known value" ;
            sh:nodeKind sh:IRI ;
            sh:path brick:lastKnownValue ] ;
    sh:rule [ a sh:TripleRule ;
            sh:object tag:Fire ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Point ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Sensor ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:Relationship quantitykind:Dimensionless,
        tag:Fire,
        tag:Point,
        tag:Sensor ;
    brick:hasAssociatedTag tag:Fire,
        tag:Point,
        tag:Sensor ;
    brick:hasQuantity quantitykind:Dimensionless .


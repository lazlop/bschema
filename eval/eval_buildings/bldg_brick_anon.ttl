            sh:object tag:Alarm ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Cycle ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Point ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:Relationship tag:Alarm,
        tag:Cycle,
        tag:Point ;
    brick:hasAssociatedTag tag:Alarm,
        tag:Cycle,
        tag:Point .


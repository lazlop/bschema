        quantitykind:Velocity ;
    qudt:iec61360Code "0112/2///62720#UAB396" ;
    qudt:literal "yd/h" ;
    qudt:symbol "yd/h" ;
    qudt:ucumCode "[yd_i].h-1"^^qudt:UCUMcs ;
    qudt:uneceCommonCode "M66" ;
    dtype:literal "yd/h" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> ;
    skos:notation "[yd_i].h-1"^^qudt:UCUMcs .

unit:YD-PER-MIN a qudt:Unit ;
    rdfs:label "yard per minute" ;
    dcterms:description "unit yard according to the Anglo-American and Imperial system of units divided by the unit minute" ;
    qudt:conversionMultiplier 0.01524 ;
    qudt:conversionMultiplierSN 1.524e-02 ;

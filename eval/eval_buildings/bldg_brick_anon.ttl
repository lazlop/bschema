    rdfs:label "Ampere per Joule"@en ;
    dcterms:description """$\\textit{Ampere per Joule}$ is the inverse measure of $joule-per-ampere$ or $weber$. 
  The measure for the reciprical of magnetic flux.
  """^^qudt:LatexString ;

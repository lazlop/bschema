    qudt:prefix prefix:Kilo ;
    qudt:symbol "kB" ;
    qudt:ucumCode "kBy"^^qudt:UCUMcs ;
    qudt:uneceCommonCode "2P" ;
    dtype:literal "kB" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> ;
    skos:notation "kBy"^^qudt:UCUMcs .


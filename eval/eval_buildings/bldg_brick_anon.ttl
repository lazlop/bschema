    qudt:ucumCode "umol.s-1"^^qudt:UCUMcs,
        "umol/s"^^qudt:UCUMcs ;
    dtype:literal "µmol/s" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> ;
    skos:notation "umol.s-1"^^qudt:UCUMcs,
        "umol/s"^^qudt:UCUMcs .


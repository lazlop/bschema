    sh:property [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:or bsh:NumericValue ;
            sh:path brick:value ],
        [ a sh:PropertyShape ;
            sh:in ( unit:FT_HG unit:KiloBAR unit:FT_H2O_39dot2DEG_F unit:LB_F-PER-FT2 unit:MicroPA unit:KiloPA_A unit:MilliM_HG unit:KiloLB_F-PER-IN2 unit:MegaBAR unit:KiloGM_F-PER-MilliM2 unit:MilliBAR unit:PicoPA unit:GigaPA unit:CentiM_HG unit:BAR unit:CentiM_H2O_4DEG_C unit:HectoPA unit:N-PER-M2 unit:MilliM_H2O unit:FT_H2O unit:MegaPSI unit:CentiM_H2O unit:PDL-PER-FT2 unit:HectoBAR unit:IN_HG_60DEG_F unit:M_H2O unit:DecaPA unit:MicroTORR unit:BARYE unit:MilliPA unit:ATM unit:N-PER-MilliM2 unit:IN_H2O_60DEG_F unit:KiloN-PER-M2 unit:PDL-PER-IN2 unit:KIP_F-PER-IN2 unit:MegaPA unit:TORR unit:KiloGM-PER-M-SEC2 unit:CentiM_HG_0DEG_C unit:KiloGM_F-PER-M2 unit:DeciBAR unit:BARAD unit:KiloGM_F-PER-CentiM2 unit:PA unit:CentiBAR unit:PlanckPressure unit:LB_F-PER-IN2 unit:PSI unit:CentiM_H20_4DEG_C unit:ATM_T unit:MilliTORR unit:IN_HG_32DEG_F unit:IN_H2O unit:MilliM_HGA unit:MicroATM unit:KiloPA unit:GM_F-PER-CentiM2 unit:IN_HG unit:MicroBAR unit:IN_H2O_39dot2DEG_F unit:DYN-PER-CentiM2 unit:N-PER-CentiM2 ) ;
            sh:maxCount 1 ;

brick:Unoccupied_Heating_Temperature_Setpoint a owl:Class,
        sh:NodeShape ;
    qudt:hasQuantityKind brick:Temperature ;
    rdfs:subClassOf brick:Heating_Temperature_Setpoint ;
    sh:rule [ a sh:TripleRule ;
            sh:object tag:Heat ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;

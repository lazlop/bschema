unit:PPB a qudt:Unit ;
    rdfs:label "Parts per billion"@en ;
    dcterms:description "Dimensionless unit for concentration. Recommended practice is to use specific units such as $ug/l$."^^qudt:LatexString ;
    qudt:applicableSystem sou:ASU,
        sou:CGS,
        sou:CGS-EMU,
        sou:CGS-ESU,
        sou:CGS-GAUSS,
        sou:IMPERIAL,
        sou:PLANCK,
        sou:SI ;
    qudt:conversionMultiplier 0.000000001 ;
    qudt:conversionMultiplierSN 1e-09 ;
    qudt:hasDimensionVector qkdv:A0E0L0I0M0H0T0D1 ;
    qudt:hasQuantityKind quantitykind:DimensionlessRatio ;
    qudt:iec61360Code "0112/2///62720#UAD926" ;
    qudt:informativeReference "http://aurora.regenstrief.org/~ucum/ucum.html#section-Derived-Unit-Atoms"^^xsd:anyURI ;
    qudt:literal "PPB" ;
    qudt:symbol "PPB" ;
    qudt:ucumCode "[ppb]"^^qudt:UCUMcs ;
    qudt:uneceCommonCode "61" ;
    dtype:literal "PPB" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> ;
    skos:notation "[ppb]"^^qudt:UCUMcs .

brick:Discharge_Air_Plenum a owl:Class,
        sh:NodeShape ;
    rdfs:subClassOf brick:Air_Plenum ;
    owl:equivalentClass brick:Supply_Air_Plenum ;
    brick:aliasOf brick:Supply_Air_Plenum .

brick:Fan_Speed_Command a owl:Class,
        sh:NodeShape ;
    rdfs:subClassOf brick:Fan_Command ;
    skos:definition "Controls the speed of fans"@en ;
    sh:rule [ a sh:TripleRule ;
            sh:object tag:Command ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Fan ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Point ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Speed ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:Relationship tag:Command,
        tag:Fan,
        tag:Point,
        tag:Speed ;
    brick:hasAssociatedTag tag:Command,
        tag:Fan,
        tag:Point,
        tag:Speed .


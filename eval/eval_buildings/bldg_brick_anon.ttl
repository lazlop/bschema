brick:Voltage_Sensor a owl:Class,
        sh:NodeShape ;
    qudt:hasQuantityKind quantitykind:Voltage ;
    rdfs:subClassOf brick:Sensor ;
    skos:definition "Measures the voltage of an electrical device or object"@en ;
    sh:property [ a sh:PropertyShape ;
            sh:class rec:VoltageObservation ;
            sh:maxCount 1 ;
            sh:name "last known value" ;
            sh:nodeKind sh:IRI ;
            sh:path brick:lastKnownValue ] ;
    sh:rule [ a sh:TripleRule ;
            sh:object tag:Point ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Sensor ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Voltage ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:Relationship quantitykind:Voltage,
        tag:Point,
        tag:Sensor,
        tag:Voltage ;
    brick:hasAssociatedTag tag:Point,
        tag:Sensor,
        tag:Voltage ;
    brick:hasQuantity quantitykind:Voltage .


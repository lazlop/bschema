            sh:object tag:Air ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Discharge ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Flow ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Occupied ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Point ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Setpoint ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Supply ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:Relationship quantitykind:VolumeFlowRate,
        tag:Air,
        tag:Discharge,
        tag:Flow,
        tag:Occupied,
        tag:Point,
        tag:Setpoint,
        tag:Supply ;
    brick:hasAssociatedTag tag:Air,
        tag:Discharge,
        tag:Flow,
        tag:Occupied,
        tag:Point,
        tag:Setpoint,
        tag:Supply ;
    brick:hasQuantity quantitykind:VolumeFlowRate .

brick:Outside_Damper a owl:Class,

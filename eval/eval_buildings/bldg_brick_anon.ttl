    qudt:applicableSystem sou:CGS,
        sou:IMPERIAL,
        sou:USCS ;
    qudt:conversionMultiplier 4.1855 ;
    qudt:conversionMultiplierSN 4.1855e+00 ;
    qudt:hasDimensionVector qkdv:A0E0L2I0M1H0T-2D0 ;

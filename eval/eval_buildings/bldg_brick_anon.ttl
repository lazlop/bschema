            sh:object tag:Setpoint ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Zone ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:Relationship quantitykind:RelativeHumidity,
        brick:Zone_Air,
        tag:Air,
        tag:Humidity,
        tag:Point,
        tag:Setpoint,
        tag:Zone ;
    brick:hasAssociatedTag tag:Air,
        tag:Humidity,
        tag:Point,
        tag:Setpoint,

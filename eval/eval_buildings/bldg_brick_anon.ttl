    dtype:literal "mi/hr" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> ;
    skos:notation "[mi_i].h-1"^^qudt:UCUMcs,
        "[mi_i]/h"^^qudt:UCUMcs .


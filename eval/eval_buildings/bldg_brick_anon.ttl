    dtype:literal "kcal/mol" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> ;
    skos:notation "kcal.mol-1"^^qudt:UCUMcs,
        "kcal/mol"^^qudt:UCUMcs .


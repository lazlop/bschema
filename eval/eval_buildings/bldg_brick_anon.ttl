    qudt:hasQuantityKind quantitykind:DynamicViscosity,
        quantitykind:Viscosity ;
    qudt:iec61360Code "0112/2///62720#UAA255" ;
    qudt:informativeReference "http://en.wikipedia.org/wiki/Poise?oldid=487835641"^^xsd:anyURI ;

    qudt:ucumCode "J.T-2"^^qudt:UCUMcs ;
    dtype:literal "J/T²" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> ;
    skos:notation "J.T-2"^^qudt:UCUMcs .

unit:J-SEC a qudt:DerivedUnit,
        qudt:Unit ;
    rdfs:label "جول ثانية"@ar,
        "joule sekunda"@cs,
        "Joulesekunde"@de,
        "joule second"@en,
        "julio segundo"@es,
        "ژول ثانیه"@fa,
        "joule-seconde"@fr,
        "जूल सैकण्ड"@hi,
        "joule per secondo"@it,
        "ジュール秒"@ja,
        "joule saat"@ms,
        "dżulosekunda"@pl,
        "joule-segundo"@pt,
        "joule-secundă"@ro,
        "джоуль-секунда"@ru,
        "joule sekunda"@sl,
        "joule saniye"@tr,
        "焦耳秒"@zh ;
    dcterms:description """
  The $\\textit{joule-second}$ is a unit equal to a $joule$ multiplied by a second, used to measure action or angular momentum. 
  The joule-second is the unit used for Planck's constant.
  """^^qudt:LatexString ;
    qudt:applicableSystem sou:CGS,
        sou:CGS-EMU,
        sou:CGS-GAUSS,
        sou:SI ;
    qudt:coherentUnitOfSystem sou:SI ;
    qudt:conversionMultiplier 1.0 ;
    qudt:conversionMultiplierSN 1e+00 ;
    qudt:definedUnitOfSystem sou:SI ;
    qudt:derivedCoherentUnitOfSystem sou:SI ;
    qudt:derivedUnitOfSystem sou:SI ;
    qudt:hasDimensionVector qkdv:A0E0L2I0M1H0T-1D0 ;
    qudt:hasQuantityKind quantitykind:Action,
        quantitykind:AngularImpulse,
        quantitykind:AngularMomentum ;
    qudt:iec61360Code "0112/2///62720#UAB151" ;
    qudt:isUnitOfSystem sou:SI ;
    qudt:literal "J·s" ;
    qudt:symbol "J·s" ;
    qudt:ucumCode "J.s"^^qudt:UCUMcs ;
    qudt:uneceCommonCode "B18" ;
    dtype:literal "J·s" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> ;
    skos:notation "J.s"^^qudt:UCUMcs .


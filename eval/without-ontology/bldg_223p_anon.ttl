bldg:149A_COMPUTER a s223:PhysicalSpace ;
    s223:hasProperty bldg:bldg.CAC-3_DI_2,
        bldg:bldg.CAC-3_ROOM_TEMP .

bldg:158_BDF_ROOM a s223:PhysicalSpace ;
    s223:hasProperty bldg:bldg.CAC-1_DI_2,
        bldg:bldg.CAC-1_ROOM_TEMP .

bldg:310A_AV_EQUIPMNT a s223:PhysicalSpace ;
    s223:hasProperty bldg:bldg.CAC-2_DI_2,
        bldg:bldg.CAC-2_ROOM_TEMP .

bldg:4FL_OFFICE_425 a s223:PhysicalSpace ;
    s223:hasProperty bldg:bldg.WIN.4FS8_TEMP.2 .

bldg:875_ROOM_TEMP a s223:PhysicalSpace ;
    s223:hasProperty bldg:bldg.EX5_875.TEMP .

bldg:AH1_Generator a s223:Equipment ;
    s223:hasProperty bldg:bldg.AH1_SYS_GEN .

bldg:AH2A_Return_Fan-in-duct a s223:Duct .

bldg:AH2B_Return_Fan-in-duct a s223:Duct .

bldg:AH4 a s223:AirHandlingUnit ;
    s223:cnx bldg:AH4-sa-in,
        bldg:AH4-sa-out ;
    s223:contains bldg:AH4_Cooling_Coil,
        bldg:AH4_Pre_Filter,
        bldg:AH4_Supply_Fan ;
    s223:hasProperty bldg:bldg.AH4_RM.TEMPIG,
        bldg:bldg.AH4_RM.TEMPPG,
        bldg:bldg.CP.RESET.AH4.IM,
        bldg:bldg.CP.RESET.AH4.REQ,
        bldg:bldg.CP.RESET.AH4.RQHRS .


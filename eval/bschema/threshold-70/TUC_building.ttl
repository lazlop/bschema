@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix bs: <urn:bschema#> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ref: <https://brickschema.org/schema/Brick/ref#> .
@prefix s4bldg: <https://saref.etsi.org/saref4bldg#> .
@prefix s4ener: <https://saref.etsi.org/saref4ener#> .
@prefix saref: <https://saref.etsi.org/core#> .

bs:Energy_version_1 a quantitykind:Energy,
        saref:Property .

bs:Humidity_version_1 a quantitykind:Humidity,
        saref:Property .

bs:Power_version_1 a quantitykind:Power,
        saref:Property .

bs:Pressure_version_1 a quantitykind:Pressure,
        saref:Property .

bs:Site_version_1 a brick:Site ;
    brick:hasPart bs:Building_version_1 ;
    ref:hasExternalReference bs:IFCReference_version_3 .

bs:Zone_version_1 a brick:Zone ;
    brick:hasPart bs:Space_version_1 ;
    ref:hasExternalReference bs:IFCReference_version_1 .

bs:Building_version_1 a brick:Building ;
    brick:hasPart bs:Storey_version_1 ;
    ref:hasExternalReference bs:IFCReference_version_2 .

bs:IFCReference_version_1 a ref:IFCReference ;
    ref:ifcGlobalID bs:Literal_version_14 ;
    ref:ifcName bs:Literal_version_13 .

bs:IFCReference_version_2 a ref:IFCReference ;
    ref:ifcGlobalID bs:Literal_version_27 ;
    ref:ifcName bs:Literal_version_25 .

bs:IFCReference_version_3 a ref:IFCReference ;
    ref:ifcGlobalID bs:Literal_version_23 ;
    ref:ifcName bs:Literal_version_24 .

bs:Literal_version_1 a rdfs:Literal .

bs:Literal_version_10 a rdfs:Literal .

bs:Literal_version_11 a rdfs:Literal .

bs:Literal_version_12 a rdfs:Literal .

bs:Literal_version_13 a rdfs:Literal .

bs:Literal_version_14 a rdfs:Literal .

bs:Literal_version_15 a rdfs:Literal .

bs:Literal_version_16 a rdfs:Literal .

bs:Literal_version_17 a rdfs:Literal .

bs:Literal_version_18 a rdfs:Literal .

bs:Literal_version_19 a rdfs:Literal .

bs:Literal_version_2 a rdfs:Literal .

bs:Literal_version_20 a rdfs:Literal .

bs:Literal_version_21 a rdfs:Literal .

bs:Literal_version_22 a rdfs:Literal .

bs:Literal_version_23 a rdfs:Literal .

bs:Literal_version_24 a rdfs:Literal .

bs:Literal_version_25 a rdfs:Literal .

bs:Literal_version_26 a rdfs:Literal .

bs:Literal_version_27 a rdfs:Literal .

bs:Literal_version_3 a rdfs:Literal .

bs:Literal_version_4 a rdfs:Literal .

bs:Literal_version_5 a rdfs:Literal .

bs:Literal_version_6 a rdfs:Literal .

bs:Literal_version_7 a rdfs:Literal .

bs:Literal_version_8 a rdfs:Literal .

bs:Literal_version_9 a rdfs:Literal .

bs:Occupancy_version_1 a quantitykind:Occupancy,
        saref:Property .

bs:Resource_version_1 ref:ifcGlobalID bs:Literal_version_6 ;
    ref:ifcName bs:Literal_version_1 .

bs:Resource_version_10 ref:hasTimeseriesId bs:Literal_version_15 .

bs:Resource_version_11 ref:hasTimeseriesId bs:Literal_version_18 .

bs:Resource_version_12 ref:hasTimeseriesId bs:Literal_version_2 .

bs:Resource_version_13 ref:hasTimeseriesId bs:Literal_version_8 .

bs:Resource_version_14 ref:hasTimeseriesId bs:Literal_version_11 .

bs:Resource_version_15 ref:hasTimeseriesId bs:Literal_version_26 .

bs:Resource_version_2 ref:hasTimeseriesId bs:Literal_version_4 .

bs:Resource_version_3 ref:hasTimeseriesId bs:Literal_version_20 .

bs:Resource_version_4 ref:hasTimeseriesId bs:Literal_version_7 .

bs:Resource_version_5 ref:ifcGlobalID bs:Literal_version_17 ;
    ref:ifcName bs:Literal_version_16 .

bs:Resource_version_6 ref:hasTimeseriesId bs:Literal_version_3 .

bs:Resource_version_7 ref:hasTimeseriesId bs:Literal_version_12 .

bs:Resource_version_8 ref:ifcGlobalID bs:Literal_version_10 ;
    ref:ifcName bs:Literal_version_9 .

bs:Resource_version_9 ref:ifcGlobalID bs:Literal_version_19 ;
    ref:ifcName bs:Literal_version_22 .

bs:Thermostat_version_2 a brick:Thermostat,
        s4bldg:UnitaryControlElement ;
    brick:hasPoint bs:Mode_Command_version_2 ;
    saref:consistOf bs:Mode_Command_version_2 ;
    s4ener:serialNumber bs:Literal_version_21 .

bs:Delay_Parameter_version_1 a brick:Delay_Parameter ;
    brick:isPointOf bs:Thermostat_version_1 ;
    ref:hasExternalReference bs:Resource_version_7 .

bs:Lockout_Command_version_1 a brick:Lockout_Command ;
    brick:isPointOf bs:Thermostat_version_1 ;
    ref:hasExternalReference bs:Resource_version_11 .

bs:Max_Air_Temperature_Setpoint_version_1 a brick:Max_Air_Temperature_Setpoint ;
    brick:isPointOf bs:Thermostat_version_1 ;
    ref:hasExternalReference bs:Resource_version_12 .

bs:Min_Air_Temperature_Setpoint_version_1 a brick:Min_Air_Temperature_Setpoint ;
    brick:isPointOf bs:Thermostat_version_1 ;
    ref:hasExternalReference bs:Resource_version_10 .

bs:Mode_Command_version_1 a brick:Mode_Command ;
    brick:isPointOf bs:Thermostat_version_1 ;
    ref:hasExternalReference bs:Resource_version_4 .

bs:Mode_Command_version_2 a brick:Mode_Command ;
    brick:isPointOf bs:Thermostat_version_2 ;
    ref:hasExternalReference bs:Resource_version_15 .

bs:Occupancy_Sensor_version_1 a brick:Occupancy_Sensor,
        saref:Sensor ;
    brick:isPointOf bs:Thermostat_version_1 ;
    ref:hasExternalReference bs:Resource_version_2 ;
    saref:observes bs:Occupancy_version_1 .

bs:On_Off_Command_version_1 a brick:On_Off_Command ;
    brick:isPointOf bs:Thermostat_version_1 ;
    ref:hasExternalReference bs:Resource_version_3 .

bs:Run_Request_Command_version_1 a brick:Run_Request_Command ;
    brick:isPointOf bs:Thermostat_version_1 ;
    ref:hasExternalReference bs:Resource_version_6 .

bs:Storey_version_1 a brick:Storey ;
    brick:hasPart bs:Space_version_1 ;
    brick:isLocationOf bs:Terminal_Unit_version_1 ;
    ref:hasExternalReference bs:Resource_version_9 ;
    s4bldg:contains bs:Terminal_Unit_version_1 .

bs:Temperature_Sensor_version_1 a brick:Temperature_Sensor,
        saref:Sensor ;
    brick:isPointOf bs:Thermostat_version_1 ;
    ref:hasExternalReference bs:Resource_version_14 ;
    saref:observes bs:Temperature_version_1 .

bs:Temperature_Setpoint_version_1 a brick:Temperature_Setpoint,
        saref:Actuator ;
    brick:isPointOf bs:Thermostat_version_1 ;
    ref:hasExternalReference bs:Resource_version_13 ;
    saref:controls bs:Temperature_version_1 .

bs:Temperature_version_1 a quantitykind:Temperature,
        saref:Property .

bs:Terminal_Unit_version_1 a brick:Terminal_Unit,
        s4bldg:FlowTerminal ;
    brick:hasLocation bs:Storey_version_1 ;
    ref:hasExternalReference bs:Resource_version_5 .

bs:Space_version_1 a brick:Space,
        s4bldg:BuildingSpace ;
    brick:isLocationOf bs:Thermostat_version_1 ;
    ref:hasExternalReference bs:Resource_version_1 ;
    s4bldg:contains bs:Thermostat_version_1 .

bs:Thermostat_version_1 a brick:Thermostat,
        s4bldg:UnitaryControlElement ;
    brick:hasLocation bs:Space_version_1 ;
    brick:hasPoint bs:Delay_Parameter_version_1,
        bs:Lockout_Command_version_1,
        bs:Max_Air_Temperature_Setpoint_version_1,
        bs:Min_Air_Temperature_Setpoint_version_1,
        bs:Mode_Command_version_1,
        bs:Occupancy_Sensor_version_1,
        bs:On_Off_Command_version_1,
        bs:Run_Request_Command_version_1,
        bs:Temperature_Sensor_version_1,
        bs:Temperature_Setpoint_version_1 ;
    ref:hasExternalReference bs:Resource_version_8 ;
    saref:consistOf bs:Delay_Parameter_version_1,
        bs:Lockout_Command_version_1,
        bs:Max_Air_Temperature_Setpoint_version_1,
        bs:Min_Air_Temperature_Setpoint_version_1,
        bs:Mode_Command_version_1,
        bs:Occupancy_Sensor_version_1,
        bs:On_Off_Command_version_1,
        bs:Run_Request_Command_version_1,
        bs:Temperature_Sensor_version_1,
        bs:Temperature_Setpoint_version_1 ;
    s4ener:serialNumber bs:Literal_version_5 .

